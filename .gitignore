# Local Claude config stays out; task checklists are a shared repo asset.
# Must be `.claude/*`, not `.claude/` — git never descends into an excluded
# directory, so a negation under one can never re-include anything.
.claude/*
!.claude/skills/
data/
uploads/
.playwright-mcp/
dev/
# Local translation cache (superseded by committed .translation-hashes.json)
.translation-cache.json

# Behavioral-eval freshness stamp (written by a green `pytest evals/` run)
evals/.eval-stamp
# Behavioral-eval cost/execution report (written by any `pytest evals/` run)
evals/.eval-metrics.json

# PDF-export CJK font, fetched by scripts/fetch_export_fonts.py
assets/fonts/
.env.bak*
